!/README.md
!/.claude-plugin/
!/skills/
/.claude-plugin/*
!/.claude-plugin/plugin.json
!/.claude-plugin/icon.png
**/*.py
**/*.pyc
**/__pycache__/
**/*.sh
**/*.bash
**/*.zsh
**/*.ps1
**/*.js
**/*.ts
**/*.go
**/*.swift
**/*.cpp
**/*.c
**/*.h
.DS_Store
.env
.env.*
